dist/
.env
store/
# BYOK vault: never commit the encrypted secrets blob or its key, anywhere
**/vault.key
**/secrets.json
/workspace/
workspaces/*
# ... but the private-pattern list is config, not workspace content: it is a
# plain list of strings the guard refuses to push, and losing it on a reinstall
# silently disables that guard.
!workspaces/.private-patterns
docs/.obsidian/
*.log
*.pid
.claude/
.playwright-mcp/
*.pdf
output/
research/
.herenow/
.DS_Store
*.db
*.db-journal
*.db-wal
*.db-shm
logs/
*.mp4
*.mov
key_pair.txt
key_pair.txt.pub
~$*
docs/CLIENT-ONBOARDING.md
docs/EXTRACTION-PLAN.md
dist-installer/
# Rendered cloud-init user-data carries deploy tokens; never commit it
deploy/rendered/
