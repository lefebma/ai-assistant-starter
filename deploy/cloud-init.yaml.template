#cloud-config
# Havn hosted-VPS user-data. Rendered from deploy/cloud-init.yaml.template by
# scripts/make-cloud-init.ts (npm run make-cloud-init); see docs/HOSTED-VPS.md
# for the full runbook. Target image: Ubuntu 24.04 LTS.
#
# The generator fills every double-brace placeholder and refuses to emit
# while any remains. Straight substitutions: HOST_NAME, TIMEZONE,
# SSH_PUBLIC_KEY, GIT_REPO, GIT_REF, GIT_CLONE_URL, INSTALL_DIR, and
# SYSTEMD_UNIT (the rendered deploy/havn.service.template).
#
# Two are computed from whether a Tailscale auth key was provided — that is
# the documented SSH toggle:
#   UFW_SSH_CMD    without Tailscale: a ufw rule opening SSH (key-only) so
#                  you can reach the box at all. With Tailscale: a no-op,
#                  leaving ZERO open inbound ports; SSH rides the tailnet.
#   TAILSCALE_CMD  with a key: install Tailscale and join the tailnet with
#                  its SSH mode on. Without: a no-op.

hostname: {{HOST_NAME}}
timezone: {{TIMEZONE}}

# Key-only SSH. Ubuntu cloud images already default to this; be explicit.
ssh_pwauth: false

# Listing users: replaces the image's default 'ubuntu' account, so the box has
# exactly one login: havn. It owns the install and runs the service; sudo is
# for the finishing steps and later maintenance.
users:
  - name: havn
    gecos: Havn assistant service
    shell: /bin/bash
    groups: [sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - "{{SSH_PUBLIC_KEY}}"

package_update: true
package_upgrade: true
packages:
  - git
  - build-essential
  - python3
  - ca-certificates
  - curl
  - ufw
  - unattended-upgrades

write_files:
  # Security patches apply themselves; nobody logs into this box daily.
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";

  # Registered but never enabled here: first-run setup is interactive, so the
  # operator starts the service after the finishing steps (docs/HOSTED-VPS.md).
  - path: /etc/systemd/system/havn.service
    content: |
      {{SYSTEMD_UNIT}}

  - path: /usr/local/lib/havn/provision.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # Havn VPS provisioning. Runs once, as root, at first boot.
      set -euo pipefail
      exec > >(tee -a /var/log/havn-provision.log) 2>&1
      echo "havn-provision: start $(date -Is)"
      # No terminal here: never let apt/debconf/needrestart try to draw a dialog.
      export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a

      # --- Node 22 (NodeSource) -------------------------------------------
      # Run the installer from a file, not `curl | bash -`: bash reads a piped
      # script incrementally, and any child that reads stdin (debconf's
      # "pending kernel upgrade" dialog, when package_upgrade installed a newer
      # kernel than the image runs) eats the rest of the script. bash then hits
      # EOF and exits 0 before the repo is written, and apt installs Ubuntu's
      # Node 18 instead. Seen on havn-test, 2026-08-22.
      curl -fsSL https://deb.nodesource.com/setup_22.x -o /tmp/nodesource_setup.sh
      bash /tmp/nodesource_setup.sh
      rm -f /tmp/nodesource_setup.sh
      apt-get install -y nodejs
      node --version
      node --version | grep -q '^v22\.' || { echo "havn-provision: expected Node 22, got $(node --version)"; exit 1; }

      # --- gog CLI (Gmail/Calendar backend) -------------------------------
      # Linux release assets are gogcli_<version>_linux_{amd64,arm64}.tar.gz
      # (docs/SETUP-GUIDE.md > Gmail). The archive unpacks a single file: gog.
      # /usr/local/bin is one of the paths the assistant probes automatically.
      ARCH=$(dpkg --print-architecture)   # amd64 or arm64
      GOG_URL=$(curl -fsSL https://api.github.com/repos/openclaw/gogcli/releases/latest \
        | grep -o "https://[^\"]*gogcli_[^\"]*_linux_${ARCH}\.tar\.gz" | head -1)
      if [ -n "$GOG_URL" ]; then
        curl -fsSL "$GOG_URL" -o /tmp/gogcli.tar.gz
        # Extract fully and locate the binary: release tarballs prefix members
        # with ./ (./gog), which a bare member name does not match (pilot finding).
        mkdir -p /tmp/gogcli-extract
        # --no-same-owner/-permissions: run as root, and release tarballs can
        # carry a ./ member whose metadata would otherwise be restored onto
        # the extraction dir (pilot finding: a ./ entry with uid 501 mode 755
        # broke /tmp on the first box).
        tar -xzf /tmp/gogcli.tar.gz --no-same-owner --no-same-permissions -C /tmp/gogcli-extract
        install -m 0755 "$(find /tmp/gogcli-extract -type f -name gog | head -1)" /usr/local/bin/gog
        rm -rf /tmp/gogcli.tar.gz /tmp/gogcli-extract
        gog --version || true
      else
        echo "WARNING: no gogcli release found for ${ARCH}; install it by hand (docs/SETUP-GUIDE.md > Gmail)"
      fi

      # No separate Claude CLI install on purpose: the engine ships inside
      # the app via @anthropic-ai/claude-agent-sdk (npm ci below brings it),
      # and a globally installed claude is a copy the assistant never calls.

      # --- Firewall: zero inbound by default ------------------------------
      # All of Havn's traffic is outbound (Telegram long-polling, Anthropic,
      # Google APIs), so nothing on this box needs to listen.
      ufw default deny incoming
      ufw default allow outgoing
      {{UFW_SSH_CMD}}
      ufw --force enable
      ufw status verbose

      # --- Tailscale (optional) -------------------------------------------
      {{TAILSCALE_CMD}}

      # --- Clone and build as the havn user -------------------------------
      # Switch users with runuser, not sudo. Hetzner's vendor-data sets a root
      # password and expires it (chpasswd: expire: true); sudo runs PAM's
      # account check on the *invoking* user, root, and refuses with "Account
      # or password is expired". runuser's PAM stack has no account phase.
      # (The pilot's chage on havn treated the wrong account; kept because it
      # is harmless and some images do expire new users too.)
      chage -d "$(date +%F)" -M -1 -E -1 havn
      # A deploy token, if one was given for a private fork, rides only in the
      # clone URL; the remote is reset immediately after so it never persists
      # in .git/config. The public repo clones anonymously.
      runuser -u havn -- git clone --branch {{GIT_REF}} "{{GIT_CLONE_URL}}" {{INSTALL_DIR}}
      runuser -u havn -- git -C {{INSTALL_DIR}} remote set-url origin "https://github.com/{{GIT_REPO}}.git"
      runuser -u havn -- mkdir -p {{INSTALL_DIR}}/logs
      runuser -u havn -- bash -lc 'cd {{INSTALL_DIR}} && npm ci --no-audit --no-fund && npm run build'

      # --- Service: registered but NOT started ----------------------------
      systemctl daemon-reload
      # Deliberately no enable/start: .env and credentials do not exist yet.

      # --- Ready marker ---------------------------------------------------
      install -d /var/lib/havn
      date -Is > /var/lib/havn/provisioned
      cat > /etc/update-motd.d/99-havn <<'MOTD'
      #!/bin/sh
      echo ""
      echo "Havn: provisioned, awaiting first-run setup."
      echo "  As the havn user:  cd {{INSTALL_DIR}} && npm run setup"
      echo "  Full finishing steps: docs/HOSTED-VPS.md in the repo."
      echo "  When setup is done:  sudo systemctl enable --now havn"
      echo ""
      MOTD
      chmod 0755 /etc/update-motd.d/99-havn
      echo "havn-provision: done $(date -Is)"

runcmd:
  - [bash, /usr/local/lib/havn/provision.sh]

final_message: "Havn VPS provisioned in $UPTIME seconds. SSH in as havn and follow docs/HOSTED-VPS.md > Finishing steps."
